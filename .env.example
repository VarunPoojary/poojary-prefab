# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Leave the two NEXT_PUBLIC_SUPABASE_* values empty to run on browser storage (localStorage) instead.

# Project URL and the publishable ("anon") key – used in the browser; row level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role ("secret") key – server only (API routes, npm run db:seed). Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: domain of the internal Supabase Auth e-mail addresses (<employee id>@<domain>); never mailed.
# NEXT_PUBLIC_SUPABASE_LOGIN_DOMAIN=users.poojary-prefab.app

# Demo projects only: show the demo accounts on the login page, and allow Quotation Maker → "Reset demo data"
# to replace ALL data with the demo data.
# NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=true
# ALLOW_DEMO_RESET=true
